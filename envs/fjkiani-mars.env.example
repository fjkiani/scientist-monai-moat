# Breast-first Mars lock — Modal workspace fjkiani (copy to envs/fjkiani-mars.env; never commit secrets)
# Usage dashboard: https://modal.com/settings/fjkiani-7298/usage
# ~/.modal.toml profiles: fjkiani (active), crispro, testing1235, crispro-test, testing-123

# ── Modal CLI ─────────────────────────────────────────────────────────────
MODAL_PROFILE=fjkiani
# From https://modal.com/settings → API tokens (do not commit real values)
MODAL_TOKEN_ID=ak-XXXXXXXXXXXXXXXXXXXXXXXX
MODAL_TOKEN_SECRET=as-XXXXXXXXXXXXXXXXXXXXXXXX

# ── Hugging Face (HAI-DEF gated models) ───────────────────────────────────
# Local dev / secret create only — not committed
HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Deploy-time overrides (see deploy/modal/*.py)
# medsiglip_app.py: default secret name medsiglip-hf-token; fjkiani has hf_token instead
MEDSIGLIP_HF_SECRET=hf_token
# medgemma_1_5_4b_app.py: default MEDGEMMA_HF_SECRET=hf_token
MEDGEMMA_HF_SECRET=hf_token

# Optional: create dedicated Modal secrets (modal secret create …)
#   medsiglip-hf-token   → HF_TOKEN=…   (medsiglip_app.py default)
#   hf_token             → HF_TOKEN=…   (exists on fjkiani; medgemma + probe)
#   huggingface-secret   → HF_TOKEN=…   (medgemma_27b_app.py)
#   txgemma-hf-token     → HF_TOKEN=…   (txgemma_app.py)
#   kaggle-api           → KAGGLE_USERNAME / KAGGLE_KEY (RSNA ingest apps)
#   fastapi_key          → (legacy; listed on fjkiani workspace)

# ── MedSigLIP / MedGemma / LUNA HTTP bases (fjkiani — live when workspace enabled) ──
MODAL_MEDSIGLIP_URL=https://fjkiani--medsiglip
MEDSIGLIP_HEALTHZ_URL=https://fjkiani--medsiglip-healthz.modal.run
MEDSIGLIP_INFO_URL=https://fjkiani--medsiglip-info.modal.run
MEDSIGLIP_EMBED_URL=https://fjkiani--medsiglip-embed.modal.run

# RSNA fusion scorer (Modal) — required for `POST /v1/screening/fusion`
# (Modal deployments may be regional: `*.us-east.modal.run`)
RSNA_FUSION_SCORE_URL=https://fjkiani--rsna-fusion-score.us-east.modal.run
RSNA_FUSION_INFO_URL=https://fjkiani--rsna-fusion-info.us-east.modal.run
RSNA_FUSION_HEALTHZ_URL=https://fjkiani--rsna-fusion-healthz.us-east.modal.run

MEDGEMMA_INFO_URL=https://fjkiani--medgemma-1-5-4b-info.modal.run
MEDGEMMA_CHAT_URL=https://fjkiani--medgemma-1-5-4b-chat.modal.run
LUNA16_MODAL_URL=https://fjkiani--luna16
LUNA16_MODAL_HEALTHZ_URL=https://fjkiani--luna16-healthz.modal.run
LUNA16_MODAL_DETECT_URL=https://fjkiani--luna16-detect.modal.run

# Production fallback while fjkiani spend-limited (see artifacts/testing1235/workspace_migration_receipt.json)
# MODAL_MEDSIGLIP_URL=https://testing1235--medsiglip
# LUNA16_MODAL_URL=https://testing1235--luna16

# Identity pins (update base_url after redeploy + healthz PASS)
# models/medsiglip_448_identity.json
# models/medgemma_1_5_4b_identity.json
# models/luna16_infer_identity.json

# ── Local CBIS / RSNA data (repo-relative or absolute) ────────────────────
REPO_ROOT=/Users/fahadkiani/Desktop/development/scientist-monai-moat
CBIS_HF_PNG_ROOT=${REPO_ROOT}/data/cbis_ddsm/hf_png/CBIS-DDSM_1024
CBIS_LABELS_DIR=${REPO_ROOT}/data/cbis_ddsm/labels
CBIS_EMBEDDINGS_DIR=${REPO_ROOT}/artifacts/cbis_ddsm_1024
# embeddings.npy, labels.npy, splits.npy, paths.npy

# LUNA16 vendor CSVs (local eval scripts)
LUNA16_ANNOTATIONS_CSV=${REPO_ROOT}/vendor/luna16_evaluation/annotations/annotations.csv
LUNA16_ANNOTATIONS_EXCLUDED_CSV=${REPO_ROOT}/vendor/luna16_evaluation/annotations/annotations_excluded.csv
LUNA16_SERIESUIDS_CSV=${REPO_ROOT}/vendor/luna16_evaluation/annotations/seriesuids.csv

# ── Modal volumes (fjkiani workspace) ─────────────────────────────────────
# Breast / screening
MODAL_VOL_CBIS_HF_PNG=cbis-ddsm-hf-png
MODAL_VOL_CBIS_TRAINING_RUNS=cbis-ddsm-training-runs
MODAL_VOL_CBIS_DICOM=cbis-ddsm-data
MODAL_VOL_OA_REPO_CODE=oa-repo-code
MODAL_VOL_RSNA_MAMMO_PNG=rsna-mammo-png
MODAL_VOL_RSNA_MAMMO_EMB=rsna-mammo-embeddings
MODAL_VOL_MEDGEMMA_15_WEIGHTS=medgemma-1-5-4b-weights
# LUNA / cases
MODAL_VOL_LUNA16_DATA=luna16-data
MODAL_VOL_LUNA16_BASELINE=luna16-baseline-weights
MODAL_VOL_LUNA16_TRAINING_RUNS=luna16-training-runs
MODAL_VOL_ONCOLOGY_CASES=oncology-arbiter-cases

# ── Artifact / training output dirs ───────────────────────────────────────
ARTIFACTS_FJKIANI_DIR=${REPO_ROOT}/artifacts/fjkiani
CBIS_MEDSIGLIP_TRAIN_RECEIPT=${REPO_ROOT}/artifacts/cbis_medsiglip/cbis_medsiglip_train_v2.json
CBIS_V3_MODEL=${REPO_ROOT}/models/cbis_ddsm_logreg_v3.joblib
RSNA_PROBE_DIR=${REPO_ROOT}/artifacts/rsna_mammo/probe_official_v1_resplit

# ── Oncology arbiter gates (local / Render) ───────────────────────────────
MEDSIGLIP_BACKEND=modal
ONCOLOGY_ARBITER_ENABLE_CBIS_DDSM_PROBE=1

