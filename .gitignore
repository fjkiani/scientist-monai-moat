# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / OS
.DS_Store
*.swp
.vscode/
.idea/

# Runtime artifacts.
# artifacts/audit/ holds two different kinds of file:
#   1. runtime audit-log tenant directories (artifacts/audit/<tenant>/audit-*.jsonl)
#   2. deliberate audit receipts committed as evidence for the external audit
# Ignore the directory *contents* (not the directory itself, otherwise the
# negation below cannot re-include anything) and re-admit the top-level
# receipt JSONs only.
artifacts/audit/*
!artifacts/audit/*.json
artifacts/logs/
*.log

# Large fixtures — CBIS-DDSM DICOMs (~120 MB, 5 files) + HF cache
# Kept out of git; regenerated on demand via tests/fixtures/download_cbis_ddsm_fixtures.py
# Metadata JSON and README are small and versioned.
tests/fixtures/cbis_ddsm/*.dcm
tests/fixtures/cbis_ddsm/**/*.dcm
tests/fixtures/cbis_ddsm/**/*.metadata
tests/fixtures/cbis_ddsm/.cache/
tests/fixtures/cbis_ddsm/img/
tests/fixtures/cbis_ddsm/cbis-ddsm-r-dataset.csv

# Any dataset CSVs pulled from HF mirrors
tests/fixtures/**/cbis-ddsm-r-dataset.csv

# Frontend
frontend/node_modules/
frontend/dist/

# v0.3.0 corpora (synthetic pathology reports live outside the repo).
data/

# LUNA16 official evaluation kit's own demo/example submission files
# (~87 MB: sampleSubmission.csv, froc_sampleSubmission*.{txt,csv,png}).
# Not produced by, or needed by, this repo's own evaluation runs against
# real subset0 results -- only the evaluator script + the ground-truth
# annotations/seriesuids CSVs (kept, small) are needed to reproduce our FROC.
vendor/luna16_evaluation/exampleFiles/
