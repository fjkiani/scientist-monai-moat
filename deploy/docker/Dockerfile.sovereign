# Sovereign on-prem oncology arbiter (RUO) — air-gapped capable base.
# Build: docker build -f deploy/docker/Dockerfile.sovereign -t crispro-oncology-ruo:72h .
# Smoke: docker run --rm -p 8080:8080 crispro-oncology-ruo:72h

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    ONCOLOGY_FORCE_CLINICALBERT_NER=0

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md /app/
COPY src /app/src
COPY models /app/models
COPY artifacts/tonight_delivery.json /app/artifacts/tonight_delivery.json
COPY fixtures/patient_sample_01 /app/fixtures/patient_sample_01
COPY scripts/demo /app/scripts/demo

RUN pip install --no-cache-dir \
    fastapi uvicorn pydantic numpy pillow \
    "safetensors>=0.4" httpx scikit-learn joblib

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -sf http://127.0.0.1:8080/healthz || curl -sf http://127.0.0.1:8080/health || exit 1
CMD ["uvicorn", "oncology_arbiter.api.app:app", "--host", "0.0.0.0", "--port", "8080"]
